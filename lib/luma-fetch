#!/bin/bash
# Download the personal Luma iCal feed.
#
# Usage: luma-fetch <secrets-file>
#
# stdout line 1 is "##luma-status:<token>", the rest is the ICS payload.
# Tokens: ok, default, insecure, network. "default" is a good payload from
# the standard Omarchy community calendar, served when there is no personal
# feed URL yet.
#
# The feed URL contains a secret token, so this script reads the secrets
# file itself and hands it to curl over stdin (--config -): the URL never
# appears in any process's argv — not this script's, not curl's — nor in
# QML or output. The response is byte-capped with head before it is
# materialized in a shell variable, so a hostile or broken endpoint cannot
# balloon this process or the QML collectors.
set -o pipefail
# Byte semantics for ${#body}, so the size cap counts bytes, not glyphs.
export LC_ALL=C

# 2 MiB: a personal feed with hundreds of events stays under 1 MiB.
MAX_FEED_BYTES=2097152

status() { printf '##luma-status:%s\n' "$1"; }

# The standard Omarchy community calendar is public; it is what the widget
# shows until a personal subscription URL is configured.
DEFAULT_ICS_URL="https://api.luma.com/ics/get?entity=calendar&id=cal-SDGGMsEps9ExsrT"

demo_dir=""
if [ -n "$LUMA_DEMO_DIR" ]; then
  demo_dir="$LUMA_DEMO_DIR"
elif [ -e "${XDG_RUNTIME_DIR:-/tmp}/luma-demo" ]; then
  demo_dir="${XDG_RUNTIME_DIR:-/tmp}/luma-demo"
fi
if [ -n "$demo_dir" ] && [ -f "$demo_dir/feed.ics" ]; then
  status ok
  cat "$demo_dir/feed.ics"
  exit 0
fi

secrets="$1"
url=""
feed_status="ok"
if [ -n "$secrets" ] && [ -f "$secrets" ]; then
  # GNU stat on Omarchy; the -f form keeps the demo runnable on BSD/macOS.
  perms=$(stat -c '%a' "$secrets" 2>/dev/null || stat -f '%Lp' "$secrets" 2>/dev/null)
  case "$perms" in
    600|400) ;;
    *)
      status insecure
      exit 4
      ;;
  esac
  url=$(grep -m1 '^LUMA_ICS_URL=' "$secrets" | cut -d= -f2- | tr -d '"' | tr -d "'")
fi

if [ -z "$url" ]; then
  url="$DEFAULT_ICS_URL"
  feed_status="default"
fi

# Luma's "Add iCal Subscription" copies a webcal:// link; that scheme is
# plain https for curl.
url=${url/#webcal:\/\//https://}

# The URL is written into a curl config line below; refuse characters that
# could escape the quoted value or smuggle extra config directives.
case "$url" in
  https://*) ;;
  *) status network; exit 6 ;;
esac
case "$url" in
  *[\"\\]*|*[[:space:]]*|*[[:cntrl:]]*) status network; exit 6 ;;
esac

# head enforces the byte cap at the pipe (curl is killed by SIGPIPE past
# it); one extra byte distinguishes "exactly at the cap" from "over it".
# Success is judged by the payload shape, not curl's exit code, which the
# cap's SIGPIPE would make ambiguous.
body=$(printf 'url = "%s"\nfail\nsilent\nshow-error\nlocation\nmax-time = 20\n' "$url" \
  | curl --config - 2>/dev/null | head -c "$((MAX_FEED_BYTES + 1))") || true
if [ -z "$body" ] || [ "${#body}" -gt "$MAX_FEED_BYTES" ]; then
  status network
  exit 6
fi
case "$body" in
  *BEGIN:VCALENDAR*) ;;
  *) status network; exit 6 ;;
esac

status "$feed_status"
printf '%s\n' "$body"
