#!/bin/bash
# Download the personal Luma iCal feed.
#
# Usage: luma-fetch <secrets-file>
#
# stdout line 1 is "##luma-status:<token>", the rest is the ICS payload.
# Tokens: ok, default, insecure, network. "default" is a good payload from
# the standard Omarchy community calendar, served when there is no personal
# feed URL yet.
#
# The feed URL contains a secret token, so this script reads the secrets
# file itself: the URL never appears in process arguments, QML, or output.
set -o pipefail

status() { printf '##luma-status:%s\n' "$1"; }

# The standard Omarchy community calendar is public; it is what the widget
# shows until a personal subscription URL is configured.
DEFAULT_ICS_URL="https://api.luma.com/ics/get?entity=calendar&id=cal-SDGGMsEps9ExsrT"

demo_dir=""
if [ -n "$LUMA_DEMO_DIR" ]; then
  demo_dir="$LUMA_DEMO_DIR"
elif [ -e "${XDG_RUNTIME_DIR:-/tmp}/luma-demo" ]; then
  demo_dir="${XDG_RUNTIME_DIR:-/tmp}/luma-demo"
fi
if [ -n "$demo_dir" ] && [ -f "$demo_dir/feed.ics" ]; then
  status ok
  cat "$demo_dir/feed.ics"
  exit 0
fi

secrets="$1"
url=""
feed_status="ok"
if [ -n "$secrets" ] && [ -f "$secrets" ]; then
  # GNU stat on Omarchy; the -f form keeps the demo runnable on BSD/macOS.
  perms=$(stat -c '%a' "$secrets" 2>/dev/null || stat -f '%Lp' "$secrets" 2>/dev/null)
  case "$perms" in
    600|400) ;;
    *)
      status insecure
      exit 4
      ;;
  esac
  url=$(grep -m1 '^LUMA_ICS_URL=' "$secrets" | cut -d= -f2- | tr -d '"' | tr -d "'")
fi

if [ -z "$url" ]; then
  url="$DEFAULT_ICS_URL"
  feed_status="default"
fi

# Luma's "Add iCal Subscription" copies a webcal:// link; that scheme is
# plain https for curl.
url=${url/#webcal:\/\//https://}

body=$(curl -fsS --max-time 20 "$url" 2>/dev/null)
if [ $? -ne 0 ] || [ -z "$body" ]; then
  status network
  exit 6
fi

status "$feed_status"
printf '%s\n' "$body"
